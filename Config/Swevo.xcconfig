// Production identity shared by the installed app and backend requests.
PRODUCT_BUNDLE_IDENTIFIER = site.kstepchan.motion
// Canonical app name used by the bundle and getV2.
SWEVO_RELEASE_NAME = Kstep
SWEVO_API_HOST = o4r8xgd.kstep.site
// Backend identity for business packageName and guest-login source.
SWEVO_SERVICE_PACKAGE_NAME = $(PRODUCT_BUNDLE_IDENTIFIER)
// Empty expansion preserves // in xcconfig URL values.
SWEVO_WEBSITE_URL = https:/$()/www.kstep.site
SWEVO_PRIVACY_URL = https:/$()/www.kstep.site/privacy.html
SWEVO_TERMS_URL = https:/$()/www.kstep.site/terms.html
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
// Load ad unit IDs from getV2.adList for this packaged AdMob app.
SWEVO_ADS_TEST_MODE = NO
SWEVO_GOOGLE_ADS_APP_ID = ca-app-pub-4423220037289714~1896065740
OTHER_LDFLAGS = $(inherited) -ObjC
